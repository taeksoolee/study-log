# =============================================================================
# Umami × Supabase × Vercel 환경변수 템플릿
#
# 검증일: 2026-07-13 (Umami v2 기준)
# 등록 위치: Vercel → Project → Settings → Environment Variables
#
# 커넥션 문자열은 Supabase Dashboard → "Connect" 버튼에서 복사한 뒤,
# 사용자명(postgres.<ref>)을 전용 역할(umami_app.<ref>)로 교체해서 사용한다.
#
# ⚠️ 호스트명을 넘겨짚지 말 것. 아래 `aws-<N>-<REGION>` 의 <N> 은 리전이 아니라
#    프로젝트가 배정된 Supavisor 클러스터 번호(aws-0 / aws-1 ...)다. 반드시
#    Dashboard 의 값을 그대로 복사한다. 틀리면 접속은 되지만 쿼리에서
#    'Tenant or user not found' 에러가 난다. (DATABASE_URL·DIRECT_DATABASE_URL 둘 다)
# =============================================================================

# [필수] 런타임용 DB 커넥션 = Supabase "Transaction pooler" (포트 6543)
#   - 서버리스(Vercel)에서 매 요청마다 커넥션을 여닫으므로 트랜잭션 풀러 사용.
#   - pgbouncer=true : prepared statement 비활성 (트랜잭션 모드 필수).
#   - schema=umami   : Umami 전용 스키마 지정.
#   - connection_limit=1 : 서버리스 함수당 커넥션 1개로 제한(고갈 방지).
DATABASE_URL="postgresql://umami_app.<PROJECT_REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=umami&connection_limit=1"

# [필수] 마이그레이션용 DB 커넥션 = Supabase "Session pooler" (포트 5432)
#   - Umami 빌드 단계(scripts/check-db.js)가 이 값으로 `prisma migrate deploy` 실행.
#   - 세션 풀러는 prepared statement 와 DDL(CREATE INDEX 등)을 지원하고 IPv4 라
#     Vercel 빌드에서 문제없이 동작한다. (순수 direct 5432 는 IPv6 전용이라 회피)
#   - pgbouncer 파라미터 없이 schema=umami 만 붙인다.
DIRECT_DATABASE_URL="postgresql://umami_app.<PROJECT_REF>:<PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:5432/postgres?schema=umami"

# [필수] 인증 토큰(JWT) 서명용 시크릿.
#   - 설치마다 고유해야 함. 생성: openssl rand -hex 32
APP_SECRET="<openssl rand -hex 32 결과>"

# ---------------------------------------------------------------------------
# 아래는 선택 값 (필요 시 주석 해제)
# ---------------------------------------------------------------------------

# 광고 차단기 우회를 위한 트래커 스크립트 파일명 (기본: script.js)
#   예) analytics.js 로 바꾸면 /analytics.js 로 스크립트 제공.
# TRACKER_SCRIPT_NAME="analytics.js"

# 사용량 텔레메트리 / 업데이트 알림 비활성화
# DISABLE_TELEMETRY="1"
# DISABLE_UPDATES="1"

# 외부 네트워크 호출 전면 차단(완전 프라이빗 모드)
# PRIVATE_MODE="1"

# DATABASE_TYPE 은 Vercel 에선 DATABASE_URL 로 자동 판별되므로 보통 불필요.
# (Docker 빌드에서만 명시 필요) DATABASE_TYPE="postgresql"
